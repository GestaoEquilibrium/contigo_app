// Cloudflare Workers (site estático). Toda rota que não é arquivo cai no
// index.html, para o roteador do app resolver (/ativar/..., /trilhas/...).
{
  "name": "contigo-app",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Endereço oficial. O domínio precisa estar ativo na conta Cloudflare
  // (zona semprecontigo.com.br) — a publicação cria/garante os dois nomes.
  "routes": [
    { "pattern": "semprecontigo.com.br", "custom_domain": true },
    { "pattern": "www.semprecontigo.com.br", "custom_domain": true }
  ]
}
